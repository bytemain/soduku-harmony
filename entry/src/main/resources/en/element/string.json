    },
    {
      "name": "privacy_operator_title",
      "value": "Operator and contact"
    },
    {
      "name": "privacy_operator_body",
      "value": "Not Bad Sudoku is provided by 杭州幻橙网络科技有限公司 (Hangzhou Huancheng Network Technology Co., Ltd.). This notice covers the offline Sudoku app. Privacy and support: support@oranix.cn. Last updated: November 2, 2026."
    },
    {
      "name": "privacy_local_title",
      "value": "Local progress and settings"
    },
    {
      "name": "privacy_local_body",
      "value": "Puzzles, entries, pencil notes, time, undo history, library progress, statistics and display preferences are stored locally to resume play and restore settings. The app requires no account and does not connect to a developer backend, advertising or analytics service."
    },
    {
      "name": "privacy_clipboard_title",
      "value": "Clipboard"
    },
    {
      "name": "privacy_clipboard_body",
      "value": "The app reads clipboard text only when you choose Import, to parse a Sudoku puzzle or seed. Copy writes the selected puzzle or seed to the clipboard. Avoid including unrelated sensitive information. The app does not monitor the clipboard in the background."
    },
    {
      "name": "privacy_hand_title",
      "value": "Optional hand detection"
    },
    {
      "name": "privacy_hand_body",
      "value": "Automatic hand detection is off by default. When enabled in Settings, the app uses system-provided holding-hand status to adjust the controls locally, without identifying you. Subscription stops when disabled or the app enters the background. Manual layout selection remains available."
    },
    {
      "name": "privacy_backup_title",
      "value": "Retention, backup and deletion"
    },
    {
      "name": "privacy_backup_body",
      "value": "Local data remains until overwritten, cleared or the app is uninstalled. You can clear app data in system application settings. System backup and restore are enabled; storage, transfer and retention depend on system services and your device settings. Local diagnostic logs may be written for troubleshooting; the app does not upload them."
    },
    {
      "name": "privacy_rights_title",
      "value": "Your choices and updates"
    },
    {
      "name": "privacy_rights_body",
      "value": "Contact the email above for privacy assistance or product support. Playing does not require your name, phone number, location or payment details. Children may use the app with guardian guidance. If online, account or third-party services are introduced, this notice will be updated and users informed as required."
    },
