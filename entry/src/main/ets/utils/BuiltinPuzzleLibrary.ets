// ============================================================
// 公开 API
// ============================================================

/**
 * 获取所有内置题库的元数据列表
 */
export function getBuiltinLibraries(): PuzzleLibrary[] {
  const result: PuzzleLibrary[] = []
  for (const def of BUILTIN_LIBRARIES) {
    const opts: CreateLibraryOptions = { difficulty: def.difficulty, tags: ['builtin'] }
    const lib = createPuzzleLibrary(
      def.id,
      def.name,
      def.description,
      'builtin',
      'sdm',
      def.puzzleData.length,
      opts,
    )
    result.push(lib)
  }
  return result
}

/**
 * 根据 libraryId 加载内置题目列表
 */
export function loadBuiltinPuzzles(libraryId: string): PuzzleEntry[] {
  const def = BUILTIN_LIBRARIES.find((d: BuiltinLibraryDef) => d.id === libraryId)
  if (!def) return []

  const entries: PuzzleEntry[] = []
  for (let i = 0; i < def.puzzleData.length; i++) {
    const entry = createPuzzleEntry(i, def.puzzleData[i], undefined, def.difficulty)
    entries.push(entry)
  }
  return entries
}

/**
 * 首次安装时初始化内置题库。
 * 检查本地是否已有内置题库索引，没有则注册。
 */
export async function initBuiltinLibraries(context: Context): Promise<void> {
  const existing = loadLibraryIndex(context)

  // 收集已有的内置题库 ID
  const existingIds = new Set<string>()
  for (const lib of existing) {
    if (lib.source === 'builtin') {
      existingIds.add(lib.id)
    }
  }

  let updated = false
  const libraries = existing.slice()

  for (const def of BUILTIN_LIBRARIES) {
    if (!existingIds.has(def.id)) {
      // 注册新的内置题库
      const initOpts: CreateLibraryOptions = { difficulty: def.difficulty, tags: ['builtin'] }
      const lib = createPuzzleLibrary(
        def.id,
        def.name,
        def.description,
        'builtin',
        'sdm',
        def.puzzleData.length,
        initOpts,
      )
      libraries.push(lib)

      // 保存题目数据
      const puzzles = loadBuiltinPuzzles(def.id)
      await saveLibraryPuzzles(context, def.id, puzzles)

      updated = true
    }
  }

  if (updated) {
    await saveLibraryIndex(context, libraries)
  }
}
