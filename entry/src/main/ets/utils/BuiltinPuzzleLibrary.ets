// 内置题库元数据
// ============================================================

/** 内置题库定义 */
class BuiltinLibraryDef {
  id: string = ''
  name: string = ''
  description: string = ''
  difficulty: Difficulty = Difficulty.EASY
  puzzleData: string[] = []

  constructor(
    id: string,
    name: string,
    description: string,
    difficulty: Difficulty,
    puzzleData: string[],
  ) {
    this.id = id
    this.name = name
    this.description = description
    this.difficulty = difficulty
    this.puzzleData = puzzleData
  }
}

