/**
 * BuiltinPuzzleLibrary.ets — 内置题库加载器
 *
 * 提供内置题库的元数据、题目数据，以及首次安装初始化逻辑。
 * 题目数据同时内嵌在代码中（确保无需 rawfile 也能工作）
 * 并可从 rawfile/puzzles/ 目录加载额外题库。
 *
 * 参考：Doc 13 §5.3, §5.7
 */
import { Context } from '@kit.AbilityKit'
import { Difficulty } from '../constants/GameConstants'
import {
  PuzzleLibrary,
  PuzzleEntry,
  CreateLibraryOptions,
  createPuzzleLibrary,
  createPuzzleEntry,
} from '../models/PuzzleLibrary'
import {
  loadLibraryIndex,
  saveLibraryIndex,
  saveLibraryPuzzles,
  loadLibraryPuzzles,
} from './PuzzleLibraryStorage'

// ============================================================
// 内置题库元数据
// ============================================================

/** 内置题库定义 */
class BuiltinLibraryDef {
  id: string = ''
  name: string = ''
  description: string = ''
  difficulty: Difficulty = Difficulty.EASY
  puzzleData: string[] = []

  constructor(
    id: string,
    name: string,
    description: string,
    difficulty: Difficulty,
    puzzleData: string[],
  ) {
    this.id = id
    this.name = name
    this.description = description
    this.difficulty = difficulty
    this.puzzleData = puzzleData
  }
}

